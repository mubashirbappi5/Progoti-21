# ==========================================
# Progoti 21 – Reunion Survey Platform
# Environment Variables Configuration
# ==========================================

# Neon Serverless PostgreSQL connection string (pooled or direct)
# Format: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Admin Dashboard Authentication Credentials
# Email address used to log into the Admin Dashboard
ADMIN_EMAIL=admin@progoti21.org

# Bcrypt hash of the admin password
# e.g., hash of "Progoti21@Admin" or similar
ADMIN_PASSWORD_HASH=

# Secret key used for signing session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=

